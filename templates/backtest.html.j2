<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>백테스트 결과 — {{ generated_kst }}</title>
<style>
  :root {
    color-scheme: light;
    --plane:#f9f9f7; --surface-1:#fcfcfb;
    --text-primary:#0b0b0b; --text-secondary:#52514e; --muted:#898781;
    --grid:#e1e0d9; --baseline:#c3c2b7; --border:rgba(11,11,11,0.10);
    --series-1:#2a78d6; --series-2:#eb6834;
    --up:#006300; --down:#d03b3b;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) {
      color-scheme: dark;
      --plane:#0d0d0d; --surface-1:#1a1a19;
      --text-primary:#ffffff; --text-secondary:#c3c2b7; --muted:#898781;
      --grid:#2c2c2a; --baseline:#383835; --border:rgba(255,255,255,0.10);
      --series-1:#3987e5; --series-2:#d95926;
      --up:#0ca30c; --down:#d03b3b;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:28px 20px 64px; background:var(--plane); color:var(--text-primary);
         font-family:system-ui,-apple-system,"Segoe UI","Apple SD Gothic Neo",sans-serif; font-size:14px; }
  .wrap { max-width:1080px; margin:0 auto; }
  h1 { font-size:19px; margin:0 0 2px; }
  .sub { color:var(--muted); font-size:12.5px; margin-bottom:22px; }
  .card { background:var(--surface-1); border:1px solid var(--border); border-radius:14px;
          padding:20px 22px; margin-bottom:16px; }
  h2 { font-size:12px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted);
       margin:0 0 14px; font-weight:600; }
  h3 { font-size:15px; margin:0 0 2px; }
  table { width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
  th { text-align:right; font-size:11px; text-transform:uppercase; letter-spacing:.05em;
       color:var(--muted); font-weight:600; padding:0 0 9px; border-bottom:1px solid var(--grid); }
  th:first-child, td:first-child { text-align:left; }
  td { padding:10px 0; border-bottom:1px solid var(--grid); text-align:right; }
  tr:last-child td { border-bottom:none; }
  .up{color:var(--up);} .down{color:var(--down);} .sec{color:var(--text-secondary);}
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(330px,1fr)); gap:16px; }
  .legend { display:flex; gap:16px; margin-top:8px; }
  .lg { display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-secondary); }
  .sw { width:10px; height:10px; border-radius:3px; }
  .axis { fill:var(--muted); font-size:11px; font-family:system-ui,sans-serif; }
  .series-label { fill:var(--text-secondary); font-size:12px; font-weight:600; font-family:system-ui,sans-serif; }
  .chart-box { position:relative; }
  .chart-box svg { display:block; }
  .tip { position:absolute; pointer-events:none; background:var(--surface-1); color:var(--text-primary);
         border:1px solid var(--border); border-radius:9px; padding:8px 11px; font-size:12.5px;
         line-height:1.55; box-shadow:0 6px 20px rgba(0,0,0,.14); white-space:nowrap;
         font-variant-numeric:tabular-nums; transform:translate(-50%,-118%); z-index:3; }
  .tip b { font-weight:600; }
  .tip .r { display:flex; align-items:center; gap:6px; }
  .tip .sw { width:9px; height:9px; border-radius:3px; }
  .tip .d { color:var(--muted); font-size:11.5px; margin-bottom:4px; }
  .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin:12px 0 4px; }
  .kpi-l { color:var(--muted); font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; }
  .kpi-v { font-size:18px; font-weight:600; margin-top:2px; }
  footer { color:var(--muted); font-size:12px; text-align:center; margin-top:26px; line-height:1.7; }
</style>
</head>
<body><div class="wrap">

<h1>백테스트 결과</h1>
<div class="sub">{{ generated_kst }} 생성 · 수수료·슬리피지 {{ fee_bps }}bp 반영 · 신호 다음 날 종가 체결 가정</div>

<section class="card">
  <h2>전체 요약</h2>
  <table>
    <thead><tr>
      <th>종목 · 전략</th><th>기간</th><th>총수익</th><th>CAGR</th><th>MDD</th>
      <th>샤프</th><th>매매</th><th>승률</th><th>보유비중</th><th>단순보유 대비</th>
    </tr></thead>
    <tbody>
    {% for r in results %}
      <tr>
        <td><strong>{{ r.ticker }}</strong> <span class="sec">{{ r.strategy }}</span></td>
        <td class="sec">{{ r.start[:7] }}~{{ r.end[:7] }}</td>
        <td class="{{ 'up' if r.total_return >= 0 else 'down' }}">{{ '{:+.1f}'.format(r.total_return) }}%</td>
        <td class="{{ 'up' if r.cagr >= 0 else 'down' }}">{{ '{:+.1f}'.format(r.cagr) }}%</td>
        <td class="down">{{ '{:.1f}'.format(r.mdd) }}%</td>
        <td class="sec">{{ '{:.2f}'.format(r.sharpe) }}</td>
        <td class="sec">{{ r.trades }}</td>
        <td class="sec">{{ '{:.0f}'.format(r.win_rate) if r.win_rate == r.win_rate else '—' }}%</td>
        <td class="sec">{{ '{:.0f}'.format(r.exposure) }}%</td>
        <td class="{{ 'up' if (r.total_return - r.bh_total_return) >= 0 else 'down' }}">
          {{ '{:+.1f}'.format(r.total_return - r.bh_total_return) }}%p</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<div class="grid2">
{% for c in charts %}
  <section class="card">
    <h3>{{ c.ticker }} · {{ c.strategy }}</h3>
    <div class="sub" style="margin-bottom:6px">{{ c.start }} ~ {{ c.end }}</div>
    <div class="kpis">
      <div><div class="kpi-l">총수익</div><div class="kpi-v {{ 'up' if c.total_return >= 0 else 'down' }}">{{ '{:+.0f}'.format(c.total_return) }}%</div></div>
      <div><div class="kpi-l">CAGR</div><div class="kpi-v {{ 'up' if c.cagr >= 0 else 'down' }}">{{ '{:+.1f}'.format(c.cagr) }}%</div></div>
      <div><div class="kpi-l">MDD</div><div class="kpi-v down">{{ '{:.0f}'.format(c.mdd) }}%</div></div>
      <div><div class="kpi-l">샤프</div><div class="kpi-v">{{ '{:.2f}'.format(c.sharpe) }}</div></div>
    </div>
    {{ c.svg|safe }}
    <div class="legend">
      <span class="lg"><span class="sw" style="background:var(--series-1)"></span>전략</span>
      <span class="lg"><span class="sw" style="background:var(--series-2)"></span>단순보유</span>
    </div>
  </section>
{% endfor %}
</div>

<footer>
  과거 데이터에 대한 시뮬레이션 결과이며 미래 수익을 보장하지 않습니다.<br>
  배당·세금은 반영하지 않았고, 체결가는 종가 기준 가정입니다.
</footer>
</div>

<script>
// 자산곡선 크로스헤어 + 툴팁
document.querySelectorAll('.chart-box').forEach(function (box) {
  var svg = box.querySelector('svg[data-chart]');
  var tip = box.querySelector('.tip');
  if (!svg || !tip) return;

  var cfg = JSON.parse(svg.getAttribute('data-chart'));
  var cross = svg.querySelector('.cross');
  var line = cross.querySelector('line');
  var vb = svg.viewBox.baseVal;
  var colors = ['var(--series-1)', 'var(--series-2)'];
  var n = cfg.dates.length;

  function move(ev) {
    var r = svg.getBoundingClientRect();
    var vx = (ev.clientX - r.left) / r.width * vb.width;
    var i = Math.round((vx - cfg.x0) / cfg.w * (n - 1));
    i = Math.max(0, Math.min(n - 1, i));
    var px = cfg.x0 + cfg.w * i / (n - 1);

    line.setAttribute('x1', px); line.setAttribute('x2', px);
    cross.style.display = '';

    var html = '<div class="d">' + cfg.dates[i] + '</div>';
    cfg.series.forEach(function (s, si) {
      html += '<div class="r"><span class="sw" style="background:' + colors[si % 2] + '"></span>'
            + s.name + ' <b>$' + s.values[i].toLocaleString(undefined, {maximumFractionDigits: 0}) + '</b></div>';
    });
    tip.innerHTML = html;
    tip.hidden = false;
    tip.style.left = (px / vb.width * r.width) + 'px';
    tip.style.top = (ev.clientY - r.top) + 'px';
  }

  function leave() { cross.style.display = 'none'; tip.hidden = true; }

  svg.addEventListener('mousemove', move);
  svg.addEventListener('mouseleave', leave);
  svg.addEventListener('touchmove', function (e) { move(e.touches[0]); }, {passive: true});
  svg.addEventListener('touchend', leave);
});
</script>
</body></html>
